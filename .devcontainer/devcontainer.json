{
  "name": "OpenMontage Cloud Setup",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "ms-python.python"
      ]
    }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y ffmpeg make git",
  "remoteUser": "vscode"
}
